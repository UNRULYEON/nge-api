{
  "name": "nge-api",
  "version": "0.1.0",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:prod": "./server",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server --asset src/db/migrations src/index.ts",
    "smoke": "bun scripts/smoke-server.ts",
    "db:generate": "bunx drizzle-kit generate",
    "generate:uuid": "bun scripts/generate-uuid.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write ."
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@modelcontextprotocol/server": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
